# Copy to .env.local (never commit it) and fill in. On Vercel, set the same names as environment variables.

# Your MCP bearer token. Server-side only: it is never sent to the browser.
AQ_TOKEN=

# Upstash Redis (REST). Without these the app falls back to an in-memory store (local dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional switches
# AQ_DRY=1            make no MCP calls at all (read what is already stored)
# AQ_WRITE_NOTES=0    do not write notes back to the MCP
